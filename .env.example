# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NEVER put a real key here — this file is committed to the repo. A real key
# committed to .env.example has already been leaked and auto-revoked twice
# this project (by GitHub/provider secret scanning) because of exactly this.
# Put your real key in a local, gitignored `.env` file instead (see .gitignore).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for Groq API calls (LLaMA Vision models).
# Users configure this via the Secrets panel in the AI Studio UI.
# Same rule as above — placeholder only, real key goes in local `.env`.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# S2_API_KEY: Optional. Raises the rate limit for the Research Portal's
# Semantic Scholar search (https://api.semanticscholar.org). The feature
# works without a key at a lower, shared rate limit. Placeholder only — see
# the note above GEMINI_API_KEY about never committing a real key here.
S2_API_KEY="MY_S2_API_KEY"

# EDGE_TTS_VOICE: Optional. Narration voice for the Doubt Solver's video
# explanations, generated via the free `edge-tts` CLI. Defaults to
# "en-US-GuyNeural". Run `edge-tts --list-voices` to see other options.
EDGE_TTS_VOICE="en-US-AriaNeural"

# WHATSAPP_VERIFY_TOKEN: Used only by the local WhatsApp webhook stand-in's
# GET verification handshake (see server/whatsapp/README.md). A live
# integration would set this to match the token configured in the Meta App
# Dashboard when registering the webhook URL.
WHATSAPP_VERIFY_TOKEN="MY_WHATSAPP_VERIFY_TOKEN"

# VITE_WHATSAPP_NUMBER: Optional. Powers the "Chat on WhatsApp" button on the
# site (see WHATSAPP.md) — a wa.me deep link to this number, in international
# format with no leading + or spaces (e.g. "919999999999"). Leave unset until
# you've registered a WhatsApp Cloud API test/sandbox number (or a real
# business number) — the button stays visibly disabled rather than linking to
# a number nobody is listening on. Must be VITE_-prefixed to reach the
# frontend bundle; requires a dev-server restart after changing.
VITE_WHATSAPP_NUMBER=""

